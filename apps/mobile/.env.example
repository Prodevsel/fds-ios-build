# apps/mobile/.env.example — copy to apps/mobile/.env (gitignored) for local dev.
# EXPO_PUBLIC_* values are compiled into the JS bundle; only ever put
# local-stack values here, never production secrets.

# Local Supabase stack (supabase start)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase status`>

# Self-hosted PowerSync Open Edition (docker-compose.powersync.yml)
EXPO_PUBLIC_POWERSYNC_URL=http://127.0.0.1:8080

# Dev-only: mount the Walking Skeleton screen instead of the spike probes.
EXPO_PUBLIC_SKELETON_FLOW=1

# Dev-only fixture credentials (WR-02: never source constants). Values match
# supabase/seed/test_fixtures.sql — valid ONLY against a locally seeded stack.
EXPO_PUBLIC_FIXTURE_REP_EMAIL=rep-x@fixture.test
EXPO_PUBLIC_FIXTURE_REP_PASSWORD=test-password
