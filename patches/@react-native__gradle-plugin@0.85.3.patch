-plugins { id("org.gradle.toolchains.foojay-resolver-convention").version("0.5.0") }
+// WORKAROUND(upstream bug, @react-native/gradle-plugin@0.85.3): this package pins
+// its own gradle-wrapper.properties to Gradle 9.3.1, but its settings.gradle.kts
+// (this file, evaluated as an included build) pins foojay-resolver-convention to
+// 0.5.0, which references `JvmVendorSpec.IBM_SEMERU` — a constant Gradle 9.3.1
+// removed. Every build fails at the settings/plugin-resolution phase with
+// "Class org.gradle.jvm.toolchain.JvmVendorSpec does not have member field
+// ...IBM_SEMERU" before a single source file compiles. Bumped to 1.0.0 (latest
+// stable per Gradle Plugin Portal), which does not reference IBM_SEMERU. Remove
+// this patch once @react-native/gradle-plugin ships a release with a compatible
+// foojay-resolver-convention pin for its own Gradle 9.3.1 wrapper.
+plugins { id("org.gradle.toolchains.foojay-resolver-convention").version("1.0.0") }
 
