# Dependencies
node_modules/
.pnpm-store/

# Expo / EAS
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
expo-env.d.ts

# Native build artifacts
android/
ios/

# Local Expo modules (apps/mobile/modules/*/ios, */android) ship real SOURCE
# under directories literally named ios/android — the blanket native-build-
# artifact ignores above would otherwise silently drop them. Un-ignore this
# specific tree (15-09, D-14b: the first local Expo module in this repo).
!apps/mobile/modules/
!apps/mobile/modules/**


# Env
.env
.env.*
!.env.example

# Local databases
*.sqlite
*.sqlite-*
*.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Spike/dev build artifacts (Phase 1 Plan 5/9 — APK built in WSL2, emulator screenshots, local run logs)
*.apk
spike-screenshot.png
metro-log.txt

# PMTiles extracts (Phase 2 Plan 01 spike) — reproducible via
# scripts/pmtiles/extract-test-tile.sh, never committed as a binary
*.pmtiles
wsl-build-log.txt

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Build output
dist/
build/

# demo user ids (regenerated by seed-demo.mjs)
scripts/demo/demo-user-ids.json

# E-Mail preview output (regenerated by `pnpm preview:emails`, never committed)
scripts/demo/email-preview/
